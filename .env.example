# NoteKing Environment Configuration
# Copy this file to .env and fill in your values

# REQUIRED: LLM API Key (OpenAI / DeepSeek / etc.)
NOTEKING_LLM_API_KEY=sk-your-api-key-here

# OPTIONAL: Custom LLM provider (default: OpenAI)
# For DeepSeek:
# NOTEKING_LLM_BASE_URL=https://api.deepseek.com
# NOTEKING_LLM_MODEL=deepseek-chat

# For local Ollama:
# NOTEKING_LLM_BASE_URL=http://localhost:11434/v1
# NOTEKING_LLM_MODEL=qwen2.5

# OPTIONAL: Proxy for YouTube access from China
# Supported formats:
#   HTTP with auth:  http://user:pass@host:port
#   SOCKS5:          socks5://127.0.0.1:7890
# NOTEKING_PROXY=http://xlgmqaqv:muquj5hng0gp@45.38.107.97:6014

# OPTIONAL: Bilibili Netscape-format cookies file
# This file will be mounted to /app/bilibili_cookies.txt inside the container.
# If the file does not exist, Bilibili requests will be made without cookies.
# BILIBILI_COOKIES_FILE=./bilibili_cookies.txt
